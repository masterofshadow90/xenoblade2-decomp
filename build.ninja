# Reconstructed uniaxially via Ninja Build System (Fixed Linker Cycle Bug)
rule compile_cpp
  command = D:/devkitPro/devkitA64/bin/aarch64-none-elf-g++.exe -O2 -mcpu=cortex-a57+crc+crypto -mtp=soft -fPIE -std=c++14 -fno-rtti -fno-exceptions -c $in -o $out
  description = [🥷 CLANG C++] Compilando $in

rule assemble_s
  command = D:/devkitPro/devkitA64/bin/aarch64-none-elf-as.exe -mcpu=cortex-a57+crc+crypto $in -o $out
  description = [🥷 ARM64 AS] Ensamblando $in

rule link_elf
  command = D:/devkitPro/devkitA64/bin/aarch64-none-elf-ld.exe -shared -Ttext=0x00100194 -Map=build/main.map @$out.rsp -o $out
  rspfile = $out.rsp
  rspfile_content = $in
  description = [🥷 LINKER ELF] Enlazando binario ejecutable final $out

build build/target/Monolithsoft/BF2/prog/application/BF2/main.o: compile_cpp src/Monolithsoft/BF2/prog/application/BF2/main.cpp
build build/target/Monolithsoft/BF2/prog/application/BF2/battle/battle_global.o: compile_cpp src/Monolithsoft/BF2/prog/application/BF2/battle/battle_global.cpp
